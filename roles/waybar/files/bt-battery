#!/usr/bin/env bash
# bt-battery: Waybar module showing battery % of connected Bluetooth devices.
#
# Uses upower, which exposes both BlueZ Battery1 devices (keyboards, mice) and
# HID power-supply batteries (Apple Magic Trackpad). Only currently-connected
# wireless devices appear in `upower -e`, so disconnected ones drop off the bar.
#
# Note: AirPods (and most Apple audio) do NOT report battery to Linux — Apple
# uses a proprietary protocol BlueZ can't read — so they won't show here.
#
#   bt-battery          -> JSON for the bar (icons + %, class by lowest battery)
#   bt-battery toggle   -> open the Bluetooth manager (blueman)

set -u

if [ "${1:-}" = "toggle" ]; then
    exec blueman-manager
fi

icon_for() {
    case "${1,,}" in
        *keyboard*|*keys*)          echo "󰌌" ;;
        *trackpad*|*mouse*)         echo "󰍽" ;;
        *airpod*|*headphone*|*headset*|*buds*) echo "󰋋" ;;
        *)                          echo "󰂱" ;;
    esac
}

parts=()
tips=()
low=101

while read -r dev; do
    info=$(upower -i "$dev" 2>/dev/null)
    # Only Bluetooth (native-path under /org/bluez) or HID batteries (hid-...).
    case "$info" in
        *"native-path:"*"/org/bluez/"*) ;;
        *"native-path:"*"hid-"*)        ;;
        *) continue ;;
    esac
    pct=$(printf '%s\n' "$info"  | awk -F': *' '/percentage:/{gsub(/%/,"",$2); print int($2); exit}')
    model=$(printf '%s\n' "$info" | awk -F': *' '/model:/{print $2; exit}')
    state=$(printf '%s\n' "$info" | awk -F': *' '/state:/{print $2; exit}')
    [ -z "$pct" ] && continue
    ic=$(icon_for "$dev $model")
    parts+=("$ic $pct%")
    tips+=("$ic ${model:-device}: $pct%${state:+ ($state)}")
    [ "$pct" -lt "$low" ] && low=$pct
done < <(upower -e)

if [ "${#parts[@]}" -eq 0 ]; then
    printf '{"text":"","tooltip":"No Bluetooth devices with battery reporting"}\n'
    exit 0
fi

if   [ "$low" -lt 15 ]; then class="critical"
elif [ "$low" -lt 30 ]; then class="warning"
else                         class="good"
fi

# Join arrays: text by spaces, tooltip by newlines.
text="${parts[*]}"
tip=$(printf '%s\\n' "${tips[@]}"); tip="${tip%\\n}"

printf '{"text":"%s","class":"%s","tooltip":"%s"}\n' "$text" "$class" "$tip"
