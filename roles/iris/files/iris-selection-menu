#!/usr/bin/env bash
# iris-selection-menu — pop the read-aloud menu at the cursor when text is
# selected. Run as the handler of `wl-paste --primary --watch` (see the
# iris-selection-watch.service), which feeds the new PRIMARY selection on stdin.
#
# The PRIMARY selection updates on mouse-UP (when you finish highlighting), so
# this fires once per completed selection, not during the drag. A short debounce
# collapses any mid-drag updates so only the settled selection shows the menu.
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"   # ensure iris-say resolves under Hyprland

text="$(cat)"

# Ignore tiny/whitespace-only selections (stray clicks, single chars).
trimmed="${text//[[:space:]]/}"
[ "${#trimmed}" -ge 3 ] || exit 0

# Debounce: each invocation stamps a token; after a quiet window, only the last
# one still matches and proceeds. Collapses mid-drag bursts into one menu.
tok="${XDG_RUNTIME_DIR:-/tmp}/iris-sel.token"
me="$$-${RANDOM}"
printf '%s' "$me" > "$tok"
sleep 0.3
[ "$(cat "$tok" 2>/dev/null)" = "$me" ] || exit 0

# Close a popup still open from an earlier selection.
pkill -x zenity 2>/dev/null || true

# A tiny dialog with ONE button: "Read aloud". Click it -> speak. Close it
# (X / Esc) -> do nothing. Short preview of the selection in the body.
preview="${text:0:90}"; [ "${#text}" -gt 90 ] && preview="${preview}…"
if zenity --info --no-wrap --title="iris" \
        --ok-label="🔊 Read aloud" --text="$preview" 2>/dev/null; then
    printf '%s' "$text" | iris-say
fi
