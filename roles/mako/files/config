# mako notification daemon — themed to match the aqua waybar capsule.
font=JetBrainsMono Nerd Font 11
background-color=#5fe3cfee
text-color=#0f2e2a
border-color=#2fd9bf
border-size=2
border-radius=14
padding=12
margin=10
default-timeout=5000
anchor=top-right
icons=1
max-icon-size=48
max-visible=5

[urgency=critical]
background-color=#e67e80
text-color=#ffffff
border-color=#e67e80
default-timeout=0
