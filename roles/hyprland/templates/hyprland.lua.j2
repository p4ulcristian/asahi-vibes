-- My Hyprland config

local terminal    = "kitty"
local herdr       = "kitty {{ lookup('env', 'HOME') }}/.local/bin/herdr"
local browser     = "chromium"
local menu        = "caelestia shell drawers toggle launcher"
local claudia     = "chromium --app=https://claudia.irisdoes.work/"
local discord     = "chromium --app=https://discord.com/app"
local mainMod     = "SUPER"

-- Monitor
hl.monitor({ output = "", mode = "preferred", position = "auto", scale = "auto" })
-- Always mirror the SmartGlasses (DP-1) onto the laptop panel (eDP-1).
-- The catch-all rule above keeps eDP-1 working on its own when the glasses are unplugged.
-- scale 1.333333 -> logical 1920x1200 (16:10) on the 2560x1600 panel
hl.monitor({ output = "eDP-1", mode = "preferred", position = "0x0", scale = 1.333333, mirror = "DP-1" })

-- Autostart
hl.on("hyprland.start", function()
    -- caelestia is the whole shell: bar, launcher, notifications, OSDs,
    -- lock screen and wallpaper. -d detaches it from this exec.
    hl.exec_cmd("caelestia shell -d")
    -- cliphist only ever contains what this watcher stores. Neither caelestia
    -- nor Wayland records clipboard history on its own: `caelestia clipboard`
    -- just reads the db this fills. No watcher, no history.
    hl.exec_cmd("wl-paste --type text --watch cliphist store")
    hl.exec_cmd("wl-paste --type image --watch cliphist store")
    hl.exec_cmd("1password --silent")
    hl.exec_cmd("/usr/lib/polkit-gnome/polkit-gnome-authentication-agent-1")
    hl.exec_cmd("brightnessctl --device=kbd_backlight set 40%")
    -- Listen for the logind lock signal (power button) and launch hyprlock.
    hl.exec_cmd("hypridle")
end)

-- Environment
hl.env("XCURSOR_SIZE", "24")
hl.env("HYPRCURSOR_SIZE", "24")

-- Look and feel
hl.config({
    general = {
        gaps_in     = 5,
        gaps_out    = 10,
        border_size = 2,
        col = {
            active_border   = { colors = {"rgba(33ccffee)", "rgba(00ff99ee)"}, angle = 45 },
            inactive_border = "rgba(595959aa)",
        },
        layout = "dwindle",
    },
    decoration = {
        rounding       = 8,
        active_opacity   = 1.0,
        inactive_opacity = 1.0,
        shadow = { enabled = true, range = 4, render_power = 3, color = 0xee1a1a1a },
        blur   = { enabled = true, size = 3, passes = 1 },
    },
    dwindle    = { preserve_split = true },
    misc       = { force_default_wallpaper = 0, disable_hyprland_logo = true },
    input = {
        kb_layout    = "us",
        follow_mouse = 1,
        sensitivity  = 0,
        touchpad     = { natural_scroll = true, tap_to_click = true, clickfinger_behavior = true, disable_while_typing = true },
    },
})

-- Animations (from saneaspect)
hl.config({ animations = { enabled = true } })
hl.curve("myBezier", { type = "bezier", points = { {0.05, 0.9}, {0.1, 1.05} } })
hl.animation({ leaf = "windows",     enabled = true, speed = 7,  bezier = "myBezier" })
hl.animation({ leaf = "windowsOut",  enabled = true, speed = 7,  bezier = "default", style = "popin 80%" })
hl.animation({ leaf = "border",      enabled = true, speed = 10, bezier = "default" })
hl.animation({ leaf = "borderangle", enabled = true, speed = 8,  bezier = "default" })
hl.animation({ leaf = "fade",        enabled = true, speed = 7,  bezier = "default" })
hl.animation({ leaf = "workspaces",  enabled = true, speed = 6,  bezier = "default" })

-- Keybindings: apps
hl.bind(mainMod .. " + Return", hl.dsp.exec_cmd(terminal))
hl.bind(mainMod .. " + SHIFT + Return", hl.dsp.exec_cmd(herdr))
hl.bind(mainMod .. " + B",      hl.dsp.exec_cmd(browser))
hl.bind(mainMod .. " + M",      hl.dsp.exec_cmd("Telegram"))
hl.bind(mainMod .. " + K",      hl.dsp.exec_cmd(claudia))
hl.bind(mainMod .. " + SHIFT + D", hl.dsp.exec_cmd(discord))
hl.bind(mainMod .. " + Space",  hl.dsp.exec_cmd(menu))
-- Toggle the bar. O, not T: keyd's cmd layer remaps Cmd+T to Ctrl+T (mac-style
-- new tab) at the evdev level, and Shift+T falls back to the same remap, so
-- neither ever reaches Hyprland. O is unmapped in keyd and passes through.
hl.bind(mainMod .. " + O", hl.dsp.exec_cmd("caelestia shell drawers toggle bar"))

-- Caelestia surfaces. N/U/P are all clear of keyd's cmd layer.
hl.bind(mainMod .. " + N", hl.dsp.exec_cmd("caelestia shell drawers toggle dashboard"))
hl.bind(mainMod .. " + U", hl.dsp.exec_cmd("caelestia shell drawers toggle utilities"))
hl.bind(mainMod .. " + P", hl.dsp.exec_cmd("caelestia shell picker open"))

-- Clipboard history. H, not the conventional V: keyd's cmd layer remaps Cmd+V
-- to Ctrl+V at the evdev level, so Super+V never reaches Hyprland.
hl.bind(mainMod .. " + H", hl.dsp.exec_cmd("caelestia clipboard"))

-- Keybindings: lock (same path as the power button: logind -> hypridle -> hyprlock)
hl.bind(mainMod .. " + SHIFT + L", hl.dsp.exec_cmd("loginctl lock-session"))

-- Keybindings: iris-talk (voice companion that watches the desktop and talks back)
-- Tap to start listening, tap again to send + hear the reply. These used to be
-- the waybar eye's click actions (left = panel, right = toggle, middle = reset);
-- waybar is gone with caelestia, so panel and reset get their own binds. I is
-- clear of keyd's cmd layer, so all three modifiers pass through.
local irisTalk = "{{ lookup('env', 'HOME') }}/.local/bin/iris-talk"
hl.bind(mainMod .. " + I",          hl.dsp.exec_cmd(irisTalk .. " toggle"))
hl.bind(mainMod .. " + SHIFT + I",  hl.dsp.exec_cmd(irisTalk .. " panel"))
hl.bind(mainMod .. " + CTRL + I",   hl.dsp.exec_cmd(irisTalk .. " reset"))

-- Keybindings: window management
hl.bind(mainMod .. " + Q", hl.dsp.window.close())
hl.bind(mainMod .. " + F", hl.dsp.window.fullscreen())
hl.bind(mainMod .. " + D", hl.dsp.window.fullscreen())
hl.bind(mainMod .. " + L", hl.dsp.window.float({ action = "toggle" }))
hl.bind(mainMod .. " + J", hl.dsp.layout("togglesplit"))

-- Keybindings: focus
hl.bind(mainMod .. " + left",  hl.dsp.focus({ direction = "left" }))
hl.bind(mainMod .. " + right", hl.dsp.focus({ direction = "right" }))
hl.bind(mainMod .. " + up",    hl.dsp.focus({ direction = "up" }))
hl.bind(mainMod .. " + down",  hl.dsp.focus({ direction = "down" }))

-- Keybindings: workspaces
for i = 1, 9 do
    hl.bind(mainMod .. " + " .. i,             hl.dsp.focus({ workspace = i }))
    hl.bind(mainMod .. " + SHIFT + " .. i,     hl.dsp.window.move({ workspace = i }))
end

-- Keybindings: screenshots (helper script handles grim/slurp/satty/wl-copy)
local screenshot  = "{{ lookup('env', 'HOME') }}/.local/bin/screenshot"
local screenrecord = "{{ lookup('env', 'HOME') }}/.local/bin/screenrecord"
hl.bind(mainMod .. " + SHIFT + S", hl.dsp.exec_cmd(screenshot .. " region"))   -- drag a region -> save + clipboard
hl.bind(mainMod .. " + SHIFT + A", hl.dsp.exec_cmd(screenshot .. " annotate")) -- region -> annotate in satty
hl.bind(mainMod .. " + SHIFT + F", hl.dsp.exec_cmd(screenshot .. " screen"))   -- whole screen
hl.bind(mainMod .. " + SHIFT + W", hl.dsp.exec_cmd(screenshot .. " window"))   -- active window
hl.bind("Print",                   hl.dsp.exec_cmd(screenshot .. " screen"))   -- Print key (if the keyboard has one)
hl.bind(mainMod .. " + Print",     hl.dsp.exec_cmd(screenshot .. " window"))

-- Keybindings: screen recording (toggle, video only -> ~/videos/recordings)
hl.bind(mainMod .. " + SHIFT + R", hl.dsp.exec_cmd(screenrecord .. " toggle"))

-- Gestures
hl.gesture({ fingers = 3, direction = "horizontal", action = "workspace" })

-- Mouse: move/resize
hl.bind(mainMod .. " + mouse:272", hl.dsp.window.drag(),   { mouse = true })
hl.bind(mainMod .. " + mouse:273", hl.dsp.window.resize(), { mouse = true })

-- Media keys
-- Ceiling is 0.85, not 1.0. The built-in speakers run through asahi-audio's
-- DSP chain with speakersafetyd behind it, and near full scale that daemon
-- pulls the tweeter group down by ~8 dB to keep the drivers inside their
-- excursion limit. Past that point extra volume buys no extra loudness, only
-- compression artefacts, so the ceiling costs nothing real. Raise it if you
-- disagree — it is a comfort limit, not the speaker protection itself, which
-- is enforced in speakersafetyd regardless of what we set here.
hl.bind("XF86AudioRaiseVolume",  hl.dsp.exec_cmd("wpctl set-volume -l 0.85 @DEFAULT_AUDIO_SINK@ 5%+"), { locked = true, repeating = true })
hl.bind("XF86AudioLowerVolume",  hl.dsp.exec_cmd("wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-"),      { locked = true, repeating = true })
hl.bind("XF86AudioMute",         hl.dsp.exec_cmd("wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"),     { locked = true })
hl.bind("XF86MonBrightnessUp",   hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%+"),                  { locked = true, repeating = true })
hl.bind("XF86MonBrightnessDown", hl.dsp.exec_cmd("brightnessctl -e4 -n2 set 5%-"),                  { locked = true, repeating = true })

-- Window rules
hl.window_rule({
    name  = "suppress-maximize-events",
    match = { class = ".*" },
    suppress_event = "maximize",
})

-- iris chat-history popup: float it centered (opened by Super+Shift+I)
hl.window_rule({
    name  = "iris-popup-float",
    match = { class = "iris-popup" },
    float = true,
    size  = "820 560",
    center = true,
})

-- iris live panel: the chromium --app window showing what iris/Claude is doing.
-- Its Wayland class is "chrome-127.0.0.1__-Default"; an exact-string match here
-- fails to float it (xdg app_id timing), but the "chrome-127.*" prefix matches
-- reliably — and only the localhost panel uses a 127.* class, never claudia/etc.
hl.window_rule({
    name  = "iris-panel-float",
    match = { class = "chrome-127.*" },
    float = true,
    size  = "900 640",
    center = true,
})

-- Mirage AR compositor keybinds
local mirageDir = os.getenv("HOME") .. "/work/mirage"
hl.bind("SUPER + SHIFT + Q", hl.dsp.exec_cmd("bash " .. mirageDir .. "/scripts/stop.sh --restore"))
hl.bind("SUPER + SHIFT + X", hl.dsp.exec_cmd("bash " .. mirageDir .. "/scripts/stop.sh --all"))
hl.bind("SUPER + SHIFT + C", hl.dsp.exec_cmd("pkill -USR1 -x mirage"))
hl.bind("SUPER + G",         hl.dsp.exec_cmd("pkill -USR2 -x mirage"))
