#!/usr/bin/env bash
# iris-actions — cursor popup "context menu" of actions on the selected text.
#
# Wayland can't inject items into apps' native right-click menus, so this is the
# systematic equivalent: a hotkey opens an anyrun popup (via its stdin plugin)
# listing actions that operate on the current selection. Add new lines here to
# grow the menu (translate, summarize, …).
set -euo pipefail
export PATH="$HOME/.local/bin:$PATH"   # ensure iris-* resolve under Hyprland

choice="$(printf '%s\n' \
    '🔊 Read aloud' \
    '⏹ Stop speaking' \
    | anyrun --plugins libstdin.so 2>/dev/null || true)"

case "$choice" in
    *"Read aloud"*)    exec iris-read-selection ;;
    *"Stop speaking"*) exec iris-say --stop ;;
    *)                 exit 0 ;;
esac
