 #include "hwmon-laptop.dtsi"
+
+/*
+ * DisplayPort-altmode audio (USB-C DP monitors / AR glasses).
+ *
+ * The ENABLE_DCPEXT_TYPEC hack in t8112-jxxx.dtsi routes the front-left
+ * USB-C port to dcpext and enables dpaudio1, but leaves the SIO
+ * coprocessor disabled and, crucially, without an /aliases/sio entry.
+ * m1n1 locates the SIO via that alias to reserve and load its firmware;
+ * without it m1n1 skips SIO setup and the coprocessor fails to boot
+ * ("apple-sio: SIO did not boot").  Add the alias and enable the nodes,
+ * mirroring the t8112-j473 (Mac mini) overlay.
+ */
+/ {
+	aliases {
+		sio = &sio;
+	};
+};
+
+&sio {
+	status = "okay";
+};
+
+&dpaudio1 {
+	status = "okay";
+};
