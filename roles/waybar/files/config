{
    "height": 34,
    "spacing": 8,
    "modules-left": ["hyprland/workspaces"],
    "modules-center": ["clock"],
    "modules-right": ["custom/iris", "custom/screenshot", "custom/screenrecord", "custom/bt-battery", "pulseaudio", "network", "battery", "tray"],

    "custom/iris": {
        "exec": "/home/paul/.local/bin/iris-talk waybar",
        "return-type": "json",
        "interval": "once",
        "signal": 9,
        "tooltip": true,
        "on-click": "/home/paul/.local/bin/iris-talk panel",
        "on-click-right": "/home/paul/.local/bin/iris-talk toggle",
        "on-click-middle": "/home/paul/.local/bin/iris-talk reset"
    },

    "custom/screenshot": {
        "format": "󰄄",
        "tooltip": true,
        "tooltip-format": "Screenshot a region (save + copy to clipboard)",
        "on-click": "/home/paul/.local/bin/screenshot region"
    },

    "custom/screenrecord": {
        "exec": "/home/paul/.local/bin/screenrecord status",
        "return-type": "json",
        "interval": "once",
        "signal": 8,
        "on-click": "/home/paul/.local/bin/screenrecord toggle"
    },

    "hyprland/workspaces": {
        "format": "{id}",
        "on-click": "/home/paul/.local/bin/hypr-workspace"
    },

    "clock": {
        "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
        "format": "󱑂 {:%a %b %d  %I:%M %p}"
    },

    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "format": "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": ["󰁺", "󰁼", "󰁾", "󰂀", "󰁹"]
    },

    "network": {
        "format-wifi": "󰖩 {essid}",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰤭 offline",
        "tooltip-format": "{essid} ({signalStrength}%)",
        "on-click": "networkmanager_dmenu"
    },

    "custom/bt-battery": {
        "exec": "/home/paul/.local/bin/bt-battery",
        "return-type": "json",
        "interval": 60,
        "on-click": "/home/paul/.local/bin/bt-battery toggle"
    },

    "pulseaudio": {
        "format": "{icon} {volume}%",
        "format-muted": "󰝟 muted",
        "format-icons": {
            "headphone": "󰋋",
            "default": ["󰕿", "󰖀", "󰕾"]
        },
        "on-click": "pavucontrol"
    },

    "tray": {
        "spacing": 8
    }
}
